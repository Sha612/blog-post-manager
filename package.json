{
  "name": "blog-post-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack blog post manager: NestJS API, Next.js web app, PostgreSQL through Prisma.",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test"
  }
}
